# tiktok-service (local dev — no database required)
TIKTOK_SERVICE_PORT=8086
LOG_LEVEL=info

GATEWAY_SECRET=hello

# Must exactly match the callback URL registered in TikTok Partner Center.
TIKTOK_REDIRECT_URI=https://dev-laco-invoice.laconic.co.th/stores/tiktok/callback

# Optional overrides
# TIKTOK_AUTH_HOST=https://auth.tiktok-shops.com
# TIKTOK_API_HOST=https://open-api.tiktokglobalshop.com

# App key/secret are NOT configured here — callers (laco-invoice) must send
# X-TikTok-App-Key and X-TikTok-App-Secret on every request.
