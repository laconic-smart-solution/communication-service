# tiktok-service (stateless)
TIKTOK_SERVICE_PORT=8086
LOG_LEVEL=info

GATEWAY_SECRET=hello

# OAuth callback URL registered in TikTok Partner Center
TIKTOK_REDIRECT_URI=https://dev-laco-invoice.laconic.co.th/stores/tiktok/callback

# Optional overrides
# TIKTOK_AUTH_HOST=https://auth.tiktok-shops.com
# TIKTOK_API_HOST=https://open-api.tiktokglobalshop.com

# App key/secret are caller-owned (laco-invoice forwards as headers):
#   X-TikTok-App-Key
#   X-TikTok-App-Secret
# Set TIKTOK_APP_KEY / TIKTOK_APP_SECRET on laco-invoice, not here.
