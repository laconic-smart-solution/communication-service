# lazada-service (local dev — no database required)
LAZADA_SERVICE_PORT=8084
LOG_LEVEL=info

GATEWAY_SECRET=hello

# Must exactly match the callback URL registered in Lazada Open Platform.
LAZADA_REDIRECT_URI=https://dev-laco-invoice.laconic.co.th/stores/lazada/callback
# Optional: th, sg, my, ph, id, vn — uses regional OAuth endpoint when set.
LAZADA_COUNTRY=th
# Keep false unless you need to force a fresh Lazada auth session.
LAZADA_FORCE_AUTH=false
# Optional override, e.g. https://api.lazada.co.th/oauth/authorize
# LAZADA_AUTH_BASE_URL=

# App key/secret are NOT configured here — callers (e.g. laco-invoice) must send
# X-Lazada-App-Key and X-Lazada-App-Secret on every request.
