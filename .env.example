# ── Gateway (Spring) ──────────────────────────────────────────
GATEWAY_PORT=8099
GATEWAY_SECRET=hello
GATEWAY_JWT_HMAC_SECRET=comms-local-dev-jwt-hmac-secret-ok!
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FACEBOOK_SERVICE_URI=http://facebook-service:8081
LINE_SERVICE_URI=http://line-service:8083
LAZADA_SERVICE_URI=http://lazada-service:8084
TELEGRAM_SERVICE_URI=http://telegram-service:8087
VIBER_SERVICE_URI=http://viber-service:8088
WECHAT_SERVICE_URI=http://wechat-service:8090
WHATSAPP_SERVICE_URI=http://whatsapp-service:8089

# ── Facebook service ──────────────────────────────────────────
FACEBOOK_SERVICE_PORT=8081
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v21.0

# ── LINE service (stateless; credentials come from calling apps) ─
LINE_SERVICE_PORT=8083

# ── Telegram service (stateless; bot token comes from calling apps) ─
TELEGRAM_SERVICE_PORT=8087

# ── Viber service (stateless; auth token comes from calling apps) ─
VIBER_SERVICE_PORT=8088

# ── WeChat OA service (stateless; AppID/token come from calling apps via headers) ─
WECHAT_SERVICE_PORT=8090

# ── Lazada service (stateless; app key/secret come from calling apps via headers) ─
LAZADA_SERVICE_PORT=8084
LAZADA_REDIRECT_URI=https://dev-laco-invoice.laconic.co.th/stores/lazada/callback
LAZADA_COUNTRY=th
LAZADA_FORCE_AUTH=false

# ── Shared database ───────────────────────────────────────────
DATABASE_URL=postgres://comms:comms@localhost:5433/communication?sslmode=disable
DB_AUTO_MIGRATE=true
POSTGRES_USER=comms
POSTGRES_PASSWORD=comms
POSTGRES_DB=communication
