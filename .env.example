PLAYGROUND_ENABLED=true

# ── Facebook service ──────────────────────────────────────────
FACEBOOK_SERVICE_PORT=8081
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
